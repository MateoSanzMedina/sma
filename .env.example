# Configuración de Entorno de SMA (Serving Management App)
ENVIRONMENT=production

# Base de Datos PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:secure_password@localhost:5432/sma_db

# Seguridad OWASP & Auth JWT (Generar clave aleatoria de al menos 32 caracteres)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_2026
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=5

# Google Generative AI (Gemini 2.5 Pro API Key)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare R2 Storage (Zero Egress Fees Object Storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=sma-files
